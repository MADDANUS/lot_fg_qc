CI_ENVIRONMENT = development

# Sesuaikan baseURL dengan lokasi project di XAMPP
# Karena project ada di htdocs/lot_fg, baseURL-nya seperti di bawah:
app.baseURL = 'http://localhost:8081/lot_fg/public/'

#--------------------------------------------------------------------
# DATABASE APLIKASI (lokal — tempat menyimpan hasil input form)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = qrcode_label
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port     = 3306

#--------------------------------------------------------------------
# DATABASE SERVER PUSAT (READ-ONLY — hanya untuk tarik data by Doc Number)
# Gunakan user MySQL yang haknya cuma SELECT, jangan pakai user admin/root.
#--------------------------------------------------------------------
database.central.hostname = 10.0.0.X
database.central.database = nama_db_pusat
database.central.username = user_readonly
database.central.password = ganti_ini
database.central.DBDriver = MySQLi
database.central.port     = 3306
